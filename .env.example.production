# =============================================================================
# ENVIRONMENT PRODUCTION - SIKAP FKP UNRI
# Domain Resmi: https://sikap.fkp.unri.ac.id
# =============================================================================

APP_NAME="SIKAP FKP UNRI"
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_DENGAN_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://sikap.fkp.unri.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DATABASE (Terkoneksi ke service container 'db' pada docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=simpeg
DB_USERNAME=sikap_user
DB_PASSWORD=Pass_SIKAP_UNRI_2026!
DB_ROOT_PASSWORD=RootPass_SIKAP_2026!

# PORT CONTAINER YANG DI-EXPOSE KE HOST VPS
APP_PORT=80
DB_EXTERNAL_PORT=127.0.0.1:3306

# AUTO MIGRATE DATABASE SAAT PERTAMA KALI JALAN
RUN_MIGRATIONS=true

# SESSION & CACHE
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# MAIL CONFIGURATION (Sesuaikan dengan SMTP Kampus UNRI / Gmail SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="keperawatan@unri.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# VITE
VITE_APP_NAME="${APP_NAME}"
