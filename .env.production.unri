APP_NAME="SIKAP FKP UNRI"
APP_ENV=production
APP_KEY=base64:2e1jlqrmA56Rit6awkFuDoywxpHtRMZqbEku+4ts5+E=
APP_DEBUG=false
APP_URL=https://sikap.fkp.unri.ac.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DATABASE MARIADB CLUSTER TIK UNRI
DB_CONNECTION=mysql
DB_HOST=mariadb-sikap-primary
DB_PORT=3306
DB_DATABASE=sikap_db
DB_USERNAME=sikap_app
DB_PASSWORD=c2tvLujmZRkwSeNs5gw4SfAr58/vrNhI

# SESSION, CACHE & QUEUE
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

# MAIL CONFIGURATION (SMTP Server UNRI / Gmail)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sikap@fkp.unri.ac.id"
MAIL_FROM_NAME="${APP_NAME}"
